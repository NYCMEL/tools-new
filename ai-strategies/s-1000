name: s-1000
description: loss of 10% or more
strategy: {
    tspy = Top 20 SPY constituents ranked by year-to-date (YTD) performance.
    tqqq = Top 20 QQQ constituents ranked by year-to-date (YTD) performance.

    t = unique(tspy ∪ tqqq)

    r = find all tickers in t whose value dropped by 10% or more over the past month

    show r
}

run s-1000
